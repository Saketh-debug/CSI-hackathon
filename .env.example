# CoolPath - Master Environment Variables Example Template
# This file serves as a reference for all environment variables across all components.
# Copy appropriate variables to the .env file in each sub-directory as described below.

# ==============================================================================
# 1. STREAMLIT-DEMO / FastAPI BACKEND (.env inside streamlit-demo/)
# ==============================================================================

# Google Earth Engine (GEE) Configuration
# The credentials JSON file should be placed inside the streamlit-demo/ directory or configured as a path.
GEE_PROJECT=umbra-intelligence
GEE_SERVICE_ACCOUNT=pixel-pioneers@umbra-intelligence.iam.gserviceaccount.com
GEE_CREDENTIALS_FILE=gee-credentials.json

# Local Ollama LLM Configuration (For EcoAssist AI Chatbot)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Twilio Credentials (For WhatsApp alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# ==============================================================================
# 2. STANDALONE WHATSAPP BOT (.env inside whatsapp_bot/)
# ==============================================================================

# Local Ollama LLM Configuration (For RAG Chatbot)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Sarvam AI Translation API Key
SARVAM_API_KEY=your_sarvam_api_key_here

# RAG Bot Configurations
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2


# ==============================================================================
# 3. REACT-VITE FRONTEND (.env inside coolpath-app/)
# ==============================================================================

# API Base URL for HTTP client (optional, defaults to empty/relative path which is proxied by Vite in dev)
VITE_API_BASE_URL=http://localhost:8000
