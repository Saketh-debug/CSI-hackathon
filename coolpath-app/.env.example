# CoolPath - React/Vite Frontend Environment Variables Template
# Copy this file to '.env' in this directory and fill in your actual values.
# Vite exposes variables starting with VITE_ to the client.

# API Base URL of the backend (e.g. FastAPI backend)
# If empty, Vite dev server proxies request /api and /static to http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
